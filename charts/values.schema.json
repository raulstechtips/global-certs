{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["internalCA", "wildcardCertificates", "secretTemplate", "infisical"],
  "properties": {
    "internalCA": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "name", "secretName", "commonName", "issuer", "pushToInfisical", "secretPath"],
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string"},
        "secretName": {"type": "string"},
        "commonName": {"type": "string"},
        "issuer": {"type": "string"},
        "pushToInfisical": {"type": "boolean"},
        "secretPath": {"type": "string"}
      }
    },
    "wildcardCertificates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "secretName", "domain", "issuer"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "secretName": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "issuer": {"type": "string", "minLength": 1}
        }
      }
    },
    "secretTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotations"],
      "properties": {
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "infisical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectSlug", "environmentSlug", "push"],
      "properties": {
        "projectSlug": {"type": "string"},
        "environmentSlug": {"type": "string"},
        "push": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostAPI", "credentialsRef"],
          "properties": {
            "hostAPI": {"type": "string"},
            "credentialsRef": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "namespace"],
              "properties": {
                "name": {"type": "string"},
                "namespace": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
